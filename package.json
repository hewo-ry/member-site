        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "babel-plugin-react-compiler": "1.0.0",
        "eslint": "^10.13.0",
        "eslint-config-next": "16.4.2",
        "pino-pretty": "^13.2.0",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3"
