{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "dev",
            "runtimeExecutable": "${workspaceFolder}/.yarn/releases/yarn-4.18.0.cjs",
            "cwd": "${workspaceFolder}",
            "runtimeArgs": [
                "dev",
            ],
            "envFile": "${workspaceFolder}/.env",
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**",
                "!**/.next/**",
            ],
        },
    ],
}
